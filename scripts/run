#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ $# -eq 0 ]]; then
    echo "Usage: scripts/run MODULE [ARGS...]" >&2
    exit 2
fi
if ! command -v docker >/dev/null; then
    echo "Docker is required. Start Docker Desktop and retry." >&2
    exit 127
fi
runs=${RSIKIT_RUNS_DIR:-"$root/runs"}
mkdir -p -- "$runs"
runs=$(cd -- "$runs" && pwd)
args=(--rm --init --user "$(id -u):$(id -g)" --read-only
      --cap-drop ALL --security-opt no-new-privileges
      --tmpfs /tmp:rw,exec,nosuid,size=1g --pids-limit 512
      --cpus "${RSIKIT_CPUS:-4}" --memory "${RSIKIT_MEMORY:-8g}"
      --volume "$runs:/app/runs" --workdir /app --env HOME=/tmp)
if [[ -t 0 && -t 1 ]]; then
    args+=(-it --env TERM=xterm-256color --env COLORTERM)
fi
env_file=${RSIKIT_ENV_FILE:-"$root/.env"}
if [[ -f "$env_file" ]]; then
    args+=(--env-file "$env_file")
elif [[ -n ${RSIKIT_ENV_FILE:-} ]]; then
    echo "Environment file not found: $env_file" >&2
    exit 2
fi
for key in OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY; do
    if [[ ${!key+x} ]]; then args+=(--env "$key"); fi
done
build_args=(build)
if [[ $1 == examples.ocean_search || $1 == examples.benchmark_ocean || $1 == research.cli || $1 == unittest ]]; then
    # Upstream's Linux build downloads x86-64 raylib/Box2D archives.
    build_args+=(--build-arg OCEAN=1 --platform linux/amd64)
    args+=(--platform linux/amd64)
fi
docker "${build_args[@]}" -t rsikit:local "$root" >&2
image_id=$(docker image inspect rsikit:local --format '{{.Id}}')
args+=(--env "RSIKIT_IMAGE_ID=$image_id")
if revision=$(git -C "$root" rev-parse HEAD 2>/dev/null); then
    args+=(--env "RSIKIT_GIT_REVISION=$revision")
fi
exec docker run "${args[@]}" rsikit:local python -u -m "$@"
